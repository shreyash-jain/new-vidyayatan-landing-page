# Contact form → Vacademy CRM lead capture.
# The /api/contact route submits to the Vacademy admin-core-service open lead
# endpoint. Sensible defaults are baked in; override here to point at a different
# audience/campaign or environment. (No auth — it's an open endpoint.)

# Full lead-submit URL (default: backend-stage.vacademy.io admin-core-service).
VACADEMY_LEAD_ENDPOINT=

# Audience the lead is attached to (default: the website contact audience).
VACADEMY_AUDIENCE_ID=

# Source type + id for attribution (defaults: AUDIENCE_CAMPAIGN, = audience id).
VACADEMY_SOURCE_TYPE=
VACADEMY_SOURCE_ID=

# Google Analytics 4 measurement id (default baked in: G-T2YCC3CXNT).
NEXT_PUBLIC_GA_ID=
